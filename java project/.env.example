# Smart Exam Seating Management System — environment configuration
#
# Copy this file to `.env` (never commit `.env`) and adjust the values.
# Every variable below has a safe local-development default baked into
# src/main/resources/application.properties, so the app runs without a .env
# file on a developer machine. The values here are DEVELOPMENT-ONLY —
# override them before any public deployment.

# ---- Database (defaults match docker-compose.yml) ----
DB_URL=jdbc:mysql://localhost:3306/room_allocation_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=Akshay@6235

# Password for the MySQL container created by `docker compose up -d`
MYSQL_ROOT_PASSWORD=Akshay@6235

# ---- Administrator account (development demo credentials) ----
# The seeder creates this account on first start. Change both values before
# deploying; passwords are stored as BCrypt hashes, never in plaintext.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin

# ---- Server ----
# Sessions expire after 30 minutes of inactivity (server.servlet.session.timeout).
# Serve the app over HTTPS in production (terminate TLS in front of the app or
# add a server.ssl.* block); cookies are session-scoped and CSRF-protected.
SERVER_PORT=8080

# ---- Native Web Push (browser notifications, self-hosted VAPID) ----
# Generate a key pair once (e.g. `npx web-push generate-vapid-keys`) and paste
# both values. VAPID_PRIVATE_KEY is a SECRET: never commit it or log it.
# The PUBLIC key is handed to the browser for pushManager.subscribe().
# When left empty the server generates an ephemeral pair at startup - fine for
# local development, but subscriptions then break on every restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL, per RFC 8292)
VAPID_SUBJECT=mailto:admin@localhost
